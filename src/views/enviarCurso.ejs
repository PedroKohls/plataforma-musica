<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Criar Curso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/enviarCurso.css" rel="stylesheet">
    <link href="/css/menu.css" rel="stylesheet">

    <script src="/js/buscas.js"></script>
</head>

<body>
    <%- include('menu', locals) %>

        <div class="editor">

            <aside class="sidebar">
                <button type="button" class="tab-btn active" onclick="openTab(event, 'pagina-1')">Página 1</button>
                <button id="adicionar" type="button" onclick="criarPagina()">Criar nova página</button>
            </aside>

            <form action="/enviarCurso" method="POST" class="editor-conteudo" enctype="multipart/form-data">

                <input type="text" name="nome" placeholder="Nome do curso">
                <textarea name="descricao" placeholder="Descrição"></textarea>

                <div class="paginas">
                    <div class="pagina show" id="pagina-1">
                        <input type="text" name="paginas[1][titulo]" placeholder="Página Introdutória ao curso">

                        <input type="hidden" name="paginas[1][conteudo]" class="input-conteudo-html">
                        
                        <div class="campos-container" id="campos-pagina-1"></div>

                        <div class="menu-adicionar-campo mt-3">
                            <select id="tipo-campo-1" class="form-select d-inline-block w-auto me-2">
                                <option value="subtitulo">Subtítulo</option>
                                <option value="paragrafo">Parágrafo</option>
                                <option value="imagem">Link de Imagem</option>
                                <option value="arquivo">Arquivo</option>
                            </select>
                            <button type="button" class="btn btn-secondary btn-sm" onclick="adicionarCampo(1)">+
                                Adicionar Campo</button>
                        </div>
                    </div>
                </div>



                <button type="submit" class="salvar">Salvar curso</button>
            </form>


        </div>
</body>

</html>