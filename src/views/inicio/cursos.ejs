<% if (ultimoCurso) { %>
    <div class="continue-section">
        <h1>Continue onde parou</h1>
        <div class="continue">
            <img src="/imagens/site/violão.jpg">
            <div class="info">
                <h2>
                    <%= ultimoCurso.nome %>
                </h2>
                <p>
                    Professor:
                    <%= ultimoCurso.Professor?.nome %>
                </p>
            </div>
        </div>
    </div>
    <% } %>

        <div class="section-header">
            <h1>Cursos em alta</h1>
            <button>Ver mais</button>
        </div>

        <div class="cards-grid">
            <% cursos.forEach(curso=> { %>
                <%- include("cards/curso",{curso}) %>
                    <% }) %>
        </div>