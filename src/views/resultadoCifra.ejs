<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Menu-->
    <link href="/css/menu.css" rel="stylesheet">
    <script src="/js/funcoes.js" defer></script>
    <script src="/js/buscas.js" defer></script>

    <link href="/css/formCifra.css" rel="stylesheet">
    <script src="/js/scriptsCifra.js"></script>
</head>

<body>
    <%- include('menu', locals) %>
        <div class="form-container">

            <h1>Confira os dados antes do envio</h1>

            <form class="form" action="/cifras/criar" method="post">
                <label>Artista</label>
                <input type="text" name="artistaNome" value="<%= artistaNome %>" readonly>
                <label>Música</label>

                <input type="text" name="musicaNomeId" value="<%= musicaNome %>" readonly>

                <input type="hidden" id="musicaId" name="musicaId" value="<%= musicaId %>">


                <label>Cifra</label>

                <textarea hidden id="editor-textarea" name="cifra" readonly><%= cifra_User %></textarea>

                <div class="cifra"><%= cifra_User %></div>

                <label>Tom</label>

                <input type="text" name="tomMusica" value="<%= tomMusica %>" readonly>

                <input type="hidden" id="tonalidade" name="tonalidade" value="<%= tonalidade %>">

                <label>Comentário</label>

                <input type="text" name="comentario" value="<%= comentario %>" readonly>

                <button type="submit">
                    Enviar
                </button>

            </form>

        </div>

        <div id="acordeBox"></div>

</body>

</html>