<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Menu-->
    <link href="/css/menu.css" rel="stylesheet">
    <script src="/js/funcoes.js" defer></script>
    <script src="/js/buscas.js" defer></script>

    <script src="/js/cursoEditor.js" defer></script>
    <link href="/css/enviarCurso.css" rel="stylesheet">
</head>

<body>
    <%- include('menu', locals) %>

    <div class="editor">
        <aside class="sidebar">
            <% if (paginas && paginas.length > 0) { %>
                <% paginas.forEach(function(pagina, index) { %>
                    <button type="button" class="tab-btn <%= index === 0 ? 'active' : '' %>"
                        onclick="openTab(event, 'pagina-<%= index + 1 %>')">Página <%= index + 1 %></button>
                <% }) %>
            <% } %>
        </aside>

        <div class="editor-conteudo p-4">
            
            <div class="header-curso mb-4 border-bottom pb-3">
                <h1 class="display-5 fw-bold"><%= curso.nome %></h1>
                <p class="lead text-muted"><%= curso.descricao %></p>
            </div>

            <div class="paginas">
                <% if (paginas && paginas.length >= 0) { %>
                    <% paginas.forEach(function(pagina, index) { %>
                        <div class="pagina <%= index === 0 ? 'show' : '' %>" id="pagina-<%= index + 1 %>">
                            <h2 class="mb-4 border-bottom pb-2 text-primary"><%= pagina.titulo %></h2>
                            <div class="conteudo-dinamico-html">
                                <% let blocos = pagina.conteudo;
                                if (typeof blocos === 'string') {
                                    try { 
                                        blocos = JSON.parse(blocos); 
                                    } catch(e) { 
                                        blocos = []; 
                                    }
                                } if (typeof blocos === 'string') {
                                    try { blocos = JSON.parse(blocos); } catch(e) { blocos = []; }
                                }

                                blocos = Array.isArray(blocos) ? blocos : []; %>

                                <% blocos.forEach(function(bloco) { %>
                                    <% if (bloco.tipo === "subtitulo") { %>
                                        <h3 class="curso-subtitulo"><%= bloco.valor %></h3>
                                    <% } %>

                                    <% if (bloco.tipo === "paragrafo") { %>
                                        <p class="curso-paragrafo"><%= bloco.valor %></p>
                                    <% } %>

                                    <% if (bloco.tipo === "imagem") { %>
                                        <img src="<%= bloco.valor %>" style="max-width:100%;">
                                    <% } %>

                                    <% if (bloco.tipo === "arquivo") { %>
                                        <a href="<%= bloco.valor %>">Download arquivo</a>
                                    <% } %>

                                <% }) %>

                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</body>

</html>
