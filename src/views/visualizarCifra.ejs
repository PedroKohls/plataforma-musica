<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cifra</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/cifra.css" rel="stylesheet">

    <script src="/js/scriptsCifra.js"></script>
</head>

<body>
    <%- include('menu', locals) %>

        <nav class="breadcrumb-container">
            <% breadcrumb.forEach(function(item, index) { %>
                <% if (item.link) { %>
                    <a href="<%= item.link %>">
                        <%= item.nome %>
                    </a>

                <% } else { %>
                    <span class="pagina-atual">
                        <%= item.nome %>
                    </span>

                    <% } %>
                        <% if (index < breadcrumb.length - 1) { %>
                            <span class="separador">
                                /
                            </span>
                        <% } %>
            <% }) %>

        </nav>

        <input type="hidden" id="tonalidade" value="<%= cifra.tonalidade %>">
        <input type="hidden" id="tomOriginal" value="<%= cifra.tom %>">

        <div class="topo">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSyW1LFVLrTeSynKd6fZW2JFbbIwM3-jBJilg&s">

            <div class="dados">
                <h1>Artista</h1>
                <h2>Música</h2>
            </div>
            <div class="controles">

                <div class="controle">
                    <label>Tom</label>
                    <select id="selectTom" name="tom" onchange="alterarTom()">
                        <% tons.forEach(function(tom) { %>
                            <option value="<%= tom.nome %>" <%=tom.nome==cifra.tom ? 'selected' : '' %>>
                                <%= tom.nome %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <div class="controle">
                    <label>Versão</label>
                    <select class="versoes" onchange="window.location.href='/cifras/' + this.value">
                        <% if (cifras && cifras.length> 0) { %>
                            <% cifras.forEach(function(item) { %>
                                <option value="<%= item.id %>" <%=item.id===cifra.id ? 'selected' : '' %>>
                                    Versão <%= item.id %> - <%= item.tom %>
                                </option>
                                <% }) %>
                                    <% } %>
                    </select>
                </div>
            </div>
        </div>
        <div class="layout">

            <div class="opcoes">
                <button class="texto">Texto</button>
                <button class="tom">1/2 tom</button>
                <button class="chords">Acordes</button>
                <button class="capotraste">Capotraste</button>
                <button class="salvar">Salvar na Lista</button>
            </div>

            <div class="cifra">
                <%= cifra.cifra %>
            </div>

        </div>

        <div id="acordeBox">
        </div>

</body>

</html>