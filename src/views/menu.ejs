<header class="menu-header">
    <div class="menu-container">

        <div class="menu-logo">
            <img src="/imagens/site/logo.png" width="250" height="100" alt="Logo">
        </div>

        <div class="menu-search">
            <input type="text" class="busca" name="busca" autocomplete="off" placeholder="O que vai tocar hoje?"
                onkeyup="procurarArtistaInicio(this.value)">

            <ul id="lista_artistas"></ul>
        </div>

        <div class="menu-options">
            <a href="/listas"><button>Listas</button></a>
            <a href="/cursos"><button>Cursos</button></a>
            <a href="/comunidade"><button>Comunidade</button></a>

            <% if (usuario) { %>

                <div class="menu-user-area">
                    <div class="menu-user-profile">
                        <div class="menu-user-info">
                            <span class="menu-user-name">
                                <%= usuario.nome %>
                            </span>
                        </div>
                        <img src="/<%= usuario.imagem %>" class="menu-user-img" id="userAvatar">
                    </div>

                    <div class="menu-dropdown" id="userMenu">
                        <div class="menu-dropdown-header">
                            <h3>Minha Conta</h3>
                            <p>Bem-vindo de volta ☺</p>
                        </div>

                        <div class="menu-grid">

                            <a href="/perfil" class="menu-item">
                                <div class="menu-icon purple">P</div>

                                <div>
                                    <strong>Perfil</strong>
                                    <span>Editar conta</span>
                                </div>
                            </a>

                            <a href="/favoritos" class="menu-item">
                                <div class="menu-icon orange">
                                    ★
                                </div>

                                <div>
                                    <strong>Favoritos</strong>
                                    <span>Suas cifras</span>
                                </div>
                            </a>

                            <a href="/historico" class="menu-item">
                                <div class="menu-icon blue">
                                    H
                                </div>

                                <div>
                                    <strong>Histórico</strong>
                                    <span>Últimos acessos</span>
                                </div>
                            </a>

                            <a href="/cursos" class="menu-item">
                                <div class="menu-icon green">
                                    C
                                </div>

                                <div>
                                    <strong>Cursos</strong>
                                    <span>Continue estudando</span>
                                </div>
                            </a>

                        </div>

                        <div class="menu-dropdown-footer">
                            <a href="/usuarios/logout" class="logout-link">
                                <button class="menu-logout-btn">
                                    Logout
                                </button>
                            </a>
                        </div>

                    </div>

                </div>

                <% } else { %>

                    <a href="/usuarios/login">
                        <button id="login">
                            Login
                        </button>
                    </a>

                    <% } %>
        </div>
    </div>
</header>