<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Menu-->
    <link href="/css/menu.css" rel="stylesheet">
    <script src="/js/funcoes.js" defer></script>
    <script src="/js/buscas.js" defer></script>

    <link rel="stylesheet" href="/css/comunidade.css">
    <script src="/js/buscas.js" defer></script>
</head>

<body>
    <%- include('menu', locals) %>
        <main class="container">

            <section class="cabecalho-comunidade">
                <div>
                    <h1>Comunidade</h1>
                    <p>Conecte-se com outros músicos, compartilhe experiências e tire dúvidas.</p>
                </div>

                <a href="/grupos/criar">
                    <button class="btn-criar">
                        + Criar Grupo
                    </button>
                </a>
            </section>

            <section class="pesquisa">
                <input type="text" class="busca" name="busca" autocomplete="off" placeholder="Pesquisar Grupos..."
                    onkeyup="procurarGrupo(this.value)">

                <ul id="lista_grupos"></ul>
            </section>

            <section class="meus-grupos">

                <div class="titulo-secao">
                    <h2>Meus Grupos</h2>
                    <a href="#">Ver todos</a>
                </div>

                <div class="cards">
                    <% gruposUsuario.forEach(function(grupoUsuario) { %>
                        <div class="card-grupo">
                            <h3>
                                <%= grupoUsuario.nome %>
                            </h3>

                            <p>
                                <%= grupoUsuario.descricao %>
                            </p>

                            <div class="info">
                                <% if (grupoUsuario.membros> 0) { %>
                                    <span>
                                        <%= grupoUsuario.membros %> membros
                                    </span>
                                    <% } else { %>
                                        <span>Nenhum membro</span>
                                        <% } %>
                            </div>
                            <a href="/grupos/<%= grupoUsuario.nome %>-<%= grupoUsuario.id %>">
                                <button>Entrar</button>
                            </a>
                        </div>
                        <% }) %>

                </div>

            </section>
            <section class="grupos-populares">

                <div class="titulo-secao">
                    <h2>Grupos Populares</h2>
                </div>

                <div class="cards">
                    <% grupos.forEach(function(grupo) { %>
                        <div class="card-grupo">
                            <h3>
                                <%= grupo.nome %>
                            </h3>

                            <p>
                                <%= grupo.descricao %>
                            </p>

                            <div class="info">
                                <% if (grupo.membros> 0) { %>
                                    <span>
                                        <%= grupo.membros %> membros
                                    </span>
                                    <% } else { %>
                                        <span>Nenhum membro</span>
                                        <% } %>
                            </div>
                            <% if (grupo.jaParticipa===true) { %>
                                <a href="/grupos/<%= grupo.nome %>-<%= grupo.id %>">
                                    <button>Entrar</button>
                                </a>
                                <% } else { %>
                                    <button onclick="participarGrupo('<%= grupo.id %>')">Inscrever-se</button>
                                    <% } %>
                        </div>
                        <% }) %>

                </div>
            </section>
        </main>

        <div id="modalConfirmacao">
            <p style="margin-bottom: 15px; font-weight: bold;">Deseja inscrever-se nesse curso?</p>
            <button id="btnConfirmarSim" style="margin-right: 10px; padding: 5px 15px;">Sim</button>
            <button id="btnConfirmarNao" onclick="fecharModal()" style="padding: 5px 15px;">Não</button>
        </div>

</body>

</html>