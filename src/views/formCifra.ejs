<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Menu-->
    <link href="/css/menu.css" rel="stylesheet">
    <script src="/js/funcoes.js" defer></script>
    <script src="/js/buscas.js" defer></script>

    <link href="/css/formCifra.css" rel="stylesheet">
    <script>
        function autoresize(el) {
            el.style.height = "auto";
            el.style.height = el.scrollHeight + "px";
        }

        document.addEventListener("DOMContentLoaded", function () {
            const checkboxArtista = document.querySelector('#novoArtista');

            let imagem = document.createElement('input');
            let div = document.getElementById("container-dados-artista");
            imagem.type = "file";
            imagem.name = "imgArtista";

            const divGenero = document.getElementById("container-genero-artista");

            checkboxArtista.addEventListener('change', (event) => {
                if (event.target.checked) {
                    div.append(imagem);
                    divGenero.classList.remove("d-none");
                } else {
                    imagem.remove();
                    divGenero.classList.add("d-none");
                }
            });
        });

    </script>
</head>

<body>

    <%- include('menu', locals) %>
        <div class="form-container">

            <h1>Enviar cifra</h1>

            <form class="form" method="POST" action="/cifras" enctype="multipart/form-data">

                <div class="form-group mb-3">

                    <label for="input-artista">Artista</label>

                    <input type="text" id="input-artista" class="form-control" name="nomeArtista"
                        placeholder="Digite o nome do artista...">

                    <select id="selec_artistas" name="artistaId" class="form-control mt-2" size="4">
                        <option value="">
                            Selecione ou crie um artista
                        </option>
                    </select>

                    <div id="container-checkbox-artista" class="form-check mt-3 d-none"
                        style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" id="novoArtista" name="criarArtista" class="form-check-input"
                            style="width: 1em; height: 1em; margin: 0;">
                        <label for="novoArtista" class="form-check-label">Criar Artista</label>
                    </div>

                    <div id="container-dados-artista" style="display: flex; align-items: center; gap: 8px;"></div>

                    <div id="container-genero-artista" class="mt-2 d-none">
                        <label for="select-genero" class="form-label">Gênero Musical</label>
                        <select id="select-genero" name="generoArtista" class="form-control">
                            <option value="rock">Rock</option>
                            <option value="pop">Pop</option>
                            <option value="sertanejo">Sertanejo</option>
                            <option value="samba">Samba</option>
                        </select>
                    </div>

                </div>

                <div class="form-group mb-3">

                    <label for="input-musica">Música</label>

                    <input type="text" id="input-musica" class="form-control" name="nomeMusica"
                        placeholder="Digite o nome da música...">

                    <select id="selec_musicas" name="musicaId" class="form-control mt-2" size="4">
                        <option value="">
                            Selecione ou crie uma música
                        </option>
                    </select>

                    <div id="container-checkbox-musica" class="form-check mt-3 d-none"
                        style="display: flex; align-items: center; gap: 8px;">
                        <input type="checkbox" id="novaMusica" name="criarMusica" class="form-check-input"
                            style="width: 1em; height: 1em; margin: 0;">
                        <label for="novaMusica" class="form-check-label">Criar Música</label>
                    </div>

                </div>

                <div class="form-group mb-3">

                    <label for="tom">Tom</label>

                    <select id="tom" name="tomMusica" class="form-control">
                        <option value="A">A</option>
                        <option value="Am">Am</option>
                        <option value="Bb">Bb</option>
                        <option value="Bbm">Bbm</option>
                        <option value="B">B</option>
                        <option value="Bm">Bm</option>
                        <option value="C">C</option>
                        <option value="Cm">Cm</option>
                        <option value="C#">C#</option>
                        <option value="C#m">C#m</option>
                        <option value="Db">Db</option>
                        <option value="D">D</option>
                        <option value="Dm">Dm</option>
                        <option value="D#">D#</option>
                        <option value="D#m">D#m</option>
                        <option value="Eb">Eb</option>
                        <option value="E">E</option>
                        <option value="Em">Em</option>
                        <option value="F">F</option>
                        <option value="Fm">Fm</option>
                        <option value="F#">F#</option>
                        <option value="F#m">F#m</option>
                        <option value="G">G</option>
                        <option value="Gm">Gm</option>
                        <option value="G#">G#</option>
                        <option value="G#m">G#m</option>
                        <option value="Ab">Ab</option>
                    </select>

                </div>

                <div class="form-group mb-3">

                    <label for="cifra">Cifra</label>

                    <textarea id="cifra" class="editor-textarea" name="cifra" required
                        oninput="autoresize(this)"></textarea>

                </div>

                <div class="form-group mb-4">

                    <label for="comentario">Comentário</label>

                    <input type="text" id="comentario" name="comentario" class="form-control">

                </div>

                <button type="submit" class="btn btn-primary">
                    Enviar cifra
                </button>

            </form>

        </div>

</body>

</html>