<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Menu-->
    <link href="/css/menu.css" rel="stylesheet">
    <script src="/js/funcoes.js" defer></script>
    <script src="/js/buscas.js" defer></script>

    <link href="/css/cadastro.css" rel="stylesheet">
</head>

<body>
    <%- include('menu', locals) %>

    <% if (typeof mensagem !=='undefined' && mensagem) { %>
        <div class="alerta">
            <%= mensagem %>
        </div>
        <% } %>

            <div class="cadastro-container">
                <form class="cadastro-form" method="POST" action="/grupos" enctype="multipart/form-data">
                    <div class="card perfil-card">
                        <h2>Seu Grupo</h2>
                        <label for="imagem" class="foto-preview">
                            <span>Foto do grupo</span>
                            <input type="file" name="imagem" id="imagem" hidden>
                        </label>
                        <div class="campo">
                            <label for="nome">Nome</label>
                            <input type="text" name="nome" id="nome" required>
                        </div>
                        <div class="campo">
                            <label for="descricao">Descrição</label>
                            <input type="text" name="descricao" id="descricao" required>
                        </div>
                        <button type="submit" class="btn-cadastro">
                            Criar Grupo
                        </button>
                    </div>
                </form>
            </div>
</body>

</html>