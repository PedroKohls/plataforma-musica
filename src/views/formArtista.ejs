<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!--Menu-->
    <link href="/css/menu.css" rel="stylesheet">
    <script src="/js/funcoes.js" defer></script>
    <script src="/js/buscas.js" defer></script>

    <link href="/css/form.css" rel="stylesheet">
</head>

<body>
    <%- include('menu', locals) %>
        <div class="form-container">
            <form class="form" action="/selecionar/musica" method="post">
                <div class="form-group mb-3">
                    <label for="input-artista">Artista</label>
                    <input type="text" id="input-artista" class="form-control"
                        placeholder="Digite o nome do artista...">

                    <select id="selec_artistas" name="artistaId" class="form-control mt-2" size="4">
                        <option value="">Selecione ou busque um artista acima</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label for="input-musica">Música</label>
                    <input type="text" id="input-musica" class="form-control" placeholder="Digite o nome da música...">

                    <select id="selec_musicas" name="musicaId" class="form-control mt-2" size="4">
                        <option value="">Selecione ou busque uma música acima</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">Avançar</button>
            </form>


        </div>
</body>

</html>